{{template "org/settings/layout_head" (dict "pageClass" "organization settings agents")}}
<style>.agent-usage{height:8px;border-radius:4px;background:var(--color-secondary);overflow:hidden;margin-bottom:4px}.agent-usage>div{height:100%}</style>
<div class="org-setting-content">
	<h4 class="ui top attached header">
		Agent-Konten
		<div class="ui right">
			<a class="ui tiny basic button" href="{{.OrgLink}}/settings/agents">Aktualisieren</a>
		</div>
	</h4>
	<div class="ui attached segment">
		{{if .SchedulerError}}
			<div class="ui negative message">Scheduler nicht erreichbar: {{.SchedulerError}}</div>
		{{else if .LoopError}}
			<div class="ui warning message">Letzter Durchlauf mit Fehler: {{.LoopError}}</div>
		{{end}}
		<table class="ui very basic table">
			<thead><tr><th>Konto</th><th>Status</th><th>5 Stunden</th><th>Woche</th><th></th></tr></thead>
			<tbody>
			{{range .Accounts}}
				<tr>
					<td>
						<img class="ui avatar tw-align-middle" src="{{AppSubUrl}}/{{.BotLogin}}.png" alt="" width="28" height="28">
						<strong>{{.DisplayName}}</strong>
						<div class="text small grey">{{.Engine}} · @{{.BotLogin}}</div>
					</td>
					<td>
						<span class="ui small {{.StateColor}} label">{{.State}}</span>
						{{if .RunningLink}}<div class="text small"><a href="{{.RunningLink}}">{{.Running.Repo}}#{{.Running.Issue}}</a></div>{{end}}
						{{if .LoginError}}<div class="text small red">{{.LoginError}}</div>{{end}}
					</td>
					<td class="tw-w-1/5">
{{if .HasFiveHour}}
						<div class="agent-usage"><div style="width:{{.FiveHour}}%;background:{{if ge .FiveHour 90}}var(--color-red){{else if ge .FiveHour 70}}var(--color-orange){{else}}var(--color-green){{end}}"></div></div>
						<div class="text small"><strong>{{.FiveHour}} %</strong> genutzt</div>
						{{if .FiveHourReset}}<div class="text small grey">setzt sich {{.FiveHourReset}} zurück</div>{{end}}
						{{else}}<div class="text small grey">{{if .Measured}}kein 5-Std-Limit{{else}}noch nicht gemessen{{end}}</div>{{end}}
					</td>
					<td class="tw-w-1/5">
{{if .HasWeek}}
						<div class="agent-usage"><div style="width:{{.Week}}%;background:{{if ge .Week 90}}var(--color-red){{else if ge .Week 70}}var(--color-orange){{else}}var(--color-green){{end}}"></div></div>
						<div class="text small"><strong>{{.Week}} %</strong> genutzt</div>
						{{if .WeekReset}}<div class="text small grey">setzt sich {{.WeekReset}} zurück</div>{{end}}
						{{else}}<div class="text small grey">noch nicht gemessen</div>{{end}}
					</td>
					<td class="right aligned">
						{{if eq .Engine "claude"}}
							{{if and .Login (eq .Login.State "need_code")}}
								<div class="ui info message tw-text-left">
									1. <a href="{{.Login.URL}}" target="_blank" rel="noopener">Hier bei Claude anmelden</a> (mit dem Konto für {{.DisplayName}})<br>
									2. Den angezeigten Code hier einfügen:
									<form class="ui form tw-flex tw-gap-1 tw-mt-2" method="post" action="{{$.OrgLink}}/settings/agents/{{.ID}}/claude-code">
										{{$.CsrfTokenHtml}}
										<input type="text" name="code" placeholder="Code" autocomplete="off" required>
										<button class="ui small primary button">Fertig</button>
									</form>
								</div>
							{{else}}
								<form class="tw-inline" method="post" action="{{$.OrgLink}}/settings/agents/{{.ID}}/claude-login">
									{{$.CsrfTokenHtml}}
									<button class="ui small primary button">{{if .LoggedIn}}Neu anmelden{{else}}Anmelden{{end}}</button>
								</form>
								<details class="tw-mt-2 tw-text-left"><summary class="text small grey">oder Token aus <code>claude setup-token</code></summary>
									<form class="ui form tw-flex tw-gap-1 tw-mt-1" method="post" action="{{$.OrgLink}}/settings/agents/{{.ID}}/claude-token">
										{{$.CsrfTokenHtml}}
										<input type="password" name="token" placeholder="sk-ant-…" autocomplete="off" required>
										<button class="ui small button">Speichern</button>
									</form>
								</details>
							{{end}}
						{{else}}
							{{if and .Login (eq .Login.State "pending")}}
								<div class="ui info message tw-text-left">
									Öffne <a href="{{.Login.URL}}" target="_blank" rel="noopener">{{.Login.URL}}</a><br>
									und gib diesen Code ein: <strong class="tw-text-16">{{.Login.Code}}</strong><br>
									<span class="text small">Danach „Aktualisieren“.</span>
								</div>
							{{else}}
								<form class="tw-inline" method="post" action="{{$.OrgLink}}/settings/agents/{{.ID}}/codex-login">
									{{$.CsrfTokenHtml}}
									<button class="ui small primary button">{{if .LoggedIn}}Neu anmelden{{else}}Anmelden{{end}}</button>
								</form>
							{{end}}
						{{end}}
						<form class="tw-inline" method="post" action="{{$.OrgLink}}/settings/agents/{{.ID}}/enabled">
							{{$.CsrfTokenHtml}}
							<input type="hidden" name="enabled" value="{{if .Enabled}}false{{else}}true{{end}}">
							<button class="ui small basic button">{{if .Enabled}}Pausieren{{else}}Aktivieren{{end}}</button>
						</form>
					</td>
				</tr>
			{{else}}
				<tr><td colspan="5">Noch keine Konten.</td></tr>
			{{end}}
			</tbody>
		</table>
		<p class="text small grey">„Genutzt“ = verbrauchtes Kontingent im Zeitfenster; zum angegebenen Zeitpunkt beginnt es wieder bei 0 %. Konten ab 90 % bekommen keine neuen Tickets. Stand: {{.Updated}}</p>
	</div>

	<h4 class="ui top attached header">Als Nächstes</h4>
	<div class="ui attached segment">
		{{if .Next}}
			<ol class="tw-m-0">
			{{range .Next}}
				<li><a href="{{.URL}}">{{.Repo}}#{{.Number}}</a> {{.Title}}
					<span class="ui tiny basic label">{{if eq .Mode "grill"}}Klären{{else if eq .Mode "triage"}}Einsortieren{{else}}Umsetzen{{end}}</span></li>
			{{end}}
			</ol>
		{{else}}
			<span class="text grey">Nichts in der Warteschlange.</span>
		{{end}}
	</div>

	<h4 class="ui top attached header">Verbrauch der letzten 7 Tage</h4>
	<div class="ui attached segment">
		{{if .UsageTotal.Runs}}
			<p><strong>{{.UsageTotal.Runs}} Läufe · {{.UsageTotal.Tokens}} Tokens · {{.UsageTotal.Cost}}</strong>
				<span class="text small grey">Kosten-Gegenwert zu API-Preisen, Näherung für die Abo-Belastung (Codex meldet keine Kosten)</span></p>
			<div class="tw-flex tw-flex-wrap tw-gap-6">
				{{range $title, $rows := dict "Nach Repo" .UsageRepos "Nach Schritt" .UsageModes "Teuerste Tickets" .UsageTop}}
				<table class="ui very basic compact table" style="width:auto">
					<thead><tr><th>{{$title}}</th><th>Läufe</th><th>Tokens</th><th>Kosten</th></tr></thead>
					<tbody>{{range $rows}}<tr><td>{{if .Link}}<a href="{{.Link}}">{{.Name}}</a>{{else}}{{.Name}}{{end}}</td><td>{{.Runs}}</td><td>{{.Tokens}}</td><td>{{.Cost}}</td></tr>{{end}}</tbody>
				</table>
				{{end}}
			</div>
		{{else}}
			<span class="text grey">Noch keine Läufe mit Verbrauchsdaten.</span>
		{{end}}
	</div>

	{{if .Blocked}}
	<h4 class="ui top attached header">Wartet auf andere Tickets</h4>
	<div class="ui attached segment">
		<ul class="tw-m-0">
		{{range .Blocked}}
			<li><a href="{{.URL}}">{{.Repo}}#{{.Number}}</a> {{.Title}} <span class="text small grey">wartet auf {{range $i, $b := .BlockedBy}}{{if $i}}, {{end}}{{$b}}{{end}}</span></li>
		{{end}}
		</ul>
	</div>
	{{end}}
</div>
{{template "org/settings/layout_footer" .}}
